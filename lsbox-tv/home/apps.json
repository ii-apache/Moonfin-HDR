{
  "_help": "Home screen apps, in order. desktop = .desktop names to try (first one found wins). match = extra window classes. color = tile gradient. image = optional full-size tile picture (PNG, 5:3). keep_warm = start it hidden at login so the first open is instant. Copy this file to ~/.config/lsbox-home/apps.json to change it, then Control Center > Restart home screen.",
  "jellyfin_config": "~/.config/refresh-match/config",
  "screensaver_minutes": 5,
  "apps": [
    {
      "key": "moonfin", "name": "Moonfin", "tagline": "Movies and shows from your server",
      "desktop": ["org.moonfin.linux", "moonfin", "io.moonfin.moonfin"],
      "match": ["org.moonfin.linux", "moonfin"],
      "color": ["#0f1b4d", "#5a3fd6"], "shelf": "jellyfin", "keep_warm": false
    },
    {
      "key": "youtube", "name": "YouTube", "tagline": "YouTube for TV",
      "desktop": ["rocks.shy.VacuumTube"],
      "match": ["vacuumtube", "rocks.shy.vacuumtube"],
      "color": ["#3a0606", "#d4282b"]
    },
    {
      "key": "spotify", "name": "Spotify", "tagline": "Music and podcasts",
      "desktop": ["com.spotify.Client", "spotify"],
      "match": ["spotify", "com.spotify.client"],
      "color": ["#04230f", "#1db954"]
    },
    {
      "key": "steam", "name": "Steam", "tagline": "Big Picture games",
      "desktop": ["steam-tv", "com.valvesoftware.Steam"],
      "match": ["steam", "com.valvesoftware.steam", "steamwebhelper"],
      "color": ["#0b1a2c", "#2a6db0"]
    },
    {
      "key": "moonlight", "name": "Moonlight", "tagline": "Stream games from your PC",
      "desktop": ["com.moonlight_stream.Moonlight"],
      "match": ["moonlight", "com.moonlight_stream.moonlight"],
      "color": ["#10162b", "#7d8bb8"]
    },
    {
      "key": "eden", "name": "Eden", "tagline": "Switch games",
      "desktop": ["dev.eden_emu.eden"],
      "match": ["eden", "dev.eden_emu.eden"],
      "color": ["#2a0d1f", "#c2366e"]
    },
    {
      "key": "settings", "name": "Settings", "tagline": "Wi-Fi, Bluetooth, sound and display",
      "desktop": ["org.kde.plasma.bigscreen.settings", "systemsettings"],
      "match": ["plasma-bigscreen-settings", "org.kde.plasma.bigscreen.settings", "systemsettings"],
      "color": ["#1c1f26", "#5c6370"]
    }
  ]
}
