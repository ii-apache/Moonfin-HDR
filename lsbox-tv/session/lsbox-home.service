# ~/.config/systemd/user/lsbox-home.service (tv user)
# Starts only in the "LSBox TV" session (LSBOX_TV=1), never in Plasma Bigscreen.
[Unit]
Description=LSBox Home (TV home screen)
PartOf=graphical-session.target
After=plasma-kwin_wayland.service
# A crash loop must not stop it for good: keep trying.
StartLimitIntervalSec=0

[Service]
ExecCondition=/usr/bin/test "${LSBOX_TV}" = 1
ExecStartPre=/bin/sh %h/.local/share/lsbox-guard
ExecStart=/usr/bin/python3 -I %h/.local/share/lsbox-home/lsbox_home.py
Restart=always
RestartSec=2
Slice=session.slice

[Install]
WantedBy=plasma-workspace.target
